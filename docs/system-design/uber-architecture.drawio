          <mxGeometry x="1510" y="460" width="190" height="100" as="geometry" />
        </mxCell>

        <!-- ================= DATA / INFRA ================= -->
        <mxCell id="node-relational-db" value="&lt;b&gt;Relational DB&lt;/b&gt;&lt;br&gt;&lt;small&gt;e.g. PostgreSQL&lt;br&gt;User, Trip, Payment data&lt;/small&gt;"
