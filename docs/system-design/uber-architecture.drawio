        </mxCell>

        <mxCell id="node-geo-store" value="&lt;b&gt;Geospatial Store&lt;/b&gt;&lt;br&gt;&lt;small&gt;e.g. Redis (geo-index)&lt;br&gt;Live driver locations&lt;/small&gt;"
