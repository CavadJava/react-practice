        </mxCell>

        <mxCell id="node-rating" value="&lt;b&gt;Rating &amp;amp; Review Service&lt;/b&gt;&lt;br&gt;&lt;small&gt;Post-trip ratings &amp;amp; reviews&lt;/small&gt;"
