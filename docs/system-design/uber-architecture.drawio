          <mxGeometry x="250" y="100" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="node-driver-app" value="&lt;b&gt;Driver Mobile App&lt;/b&gt;&lt;br&gt;&lt;small&gt;iOS / Android&lt;/small&gt;"
