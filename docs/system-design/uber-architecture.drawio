<mxfile host="app.diagrams.net">
  <diagram name="Uber-like Ride-Hailing Architecture" id="uber-arch-1">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1"
        connect="1" arrows="1" fold="1" page="1" pageScale="1"
        pageWidth="1740" pageHeight="1320" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ================= TITLE ================= -->
        <mxCell id="title" value="Uber-like Ride-Hailing System &#45;&#45; High-Level Architecture"
            style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#333333;"
            vertex="1" parent="1">
          <mxGeometry x="20" y="0" width="1700" height="32" as="geometry" />
        </mxCell>

        <!-- ================= LAYER BACKGROUNDS ================= -->
        <mxCell id="layer-clients" value="CLIENTS"
